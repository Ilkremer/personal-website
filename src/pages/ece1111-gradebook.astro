---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Private, browser-based ECE 1111 weighted grade tracker." />
  <meta name="theme-color" content="#7a1f3d" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%237a1f3d'/%3E%3Cpath d='M16 43V21h32v7H24v2h19v7H24v6z' fill='white'/%3E%3C/svg%3E" />
  <title>ECE 1111 Gradebook</title>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">ECE 1111 · FALL 2026</p>
        <h1>Gradebook</h1>
      </div>
      <div class="top-actions">
        <span id="save-status" class="save-status" aria-live="polite">Saved locally</span>
        <button id="reset-button" class="button button-quiet" type="button">Reset all</button>
      </div>
    </header>

    <div class="dashboard">
      <aside class="summary-panel" aria-label="Grade summary">
        <section class="grade-hero">
          <div class="ring" id="grade-ring" aria-hidden="true">
            <div class="ring-inner">
              <strong id="current-grade">—</strong>
              <span>current</span>
            </div>
          </div>
          <div>
            <p class="metric-label">Current grade</p>
            <p id="letter-grade" class="letter-grade">No grades yet</p>
            <p class="metric-help">Calculated only from categories with graded work.</p>
          </div>
        </section>

        <div class="metric-grid">
          <section class="metric-card">
            <span class="metric-label">Course points earned</span>
            <strong id="course-points">0.00</strong>
            <span>out of 100</span>
          </section>
          <section class="metric-card">
            <span class="metric-label">Graded weight</span>
            <strong id="graded-weight">0%</strong>
            <span id="remaining-weight">100% remaining</span>
          </section>
        </div>

        <section class="breakdown-card">
          <div class="section-heading compact">
            <div>
              <p class="eyebrow">WEIGHT MAP</p>
              <h2>Course breakdown</h2>
            </div>
            <span class="weight-total">100%</span>
          </div>
          <div id="weight-breakdown" class="weight-breakdown"></div>
        </section>

        <section class="privacy-note">
          <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
            <path d="M12 3 5 6v5c0 4.8 2.8 8.2 7 10 4.2-1.8 7-5.2 7-10V6l-7-3Zm0 4a3 3 0 0 1 3 3v1h1v5H8v-5h1v-1a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v1h2v-1a1 1 0 0 0-1-1Z" fill="currentColor"/>
          </svg>
          <p><strong>Your grades stay on this device.</strong> Entries are saved in this browser and are not uploaded.</p>
        </section>
      </aside>

      <section class="workspace" aria-label="Grade entries">
        <div class="workspace-intro">
          <div>
            <p class="eyebrow">ASSIGNMENTS</p>
            <h2>Enter scores as they arrive</h2>
          </div>
          <p>Use the points from each grade email. Blank rows are ignored.</p>
        </div>

        <div id="categories" class="categories"></div>

        <section class="extra-card">
          <div class="category-header">
            <div class="category-title">
              <span class="category-index bonus-index">+</span>
              <div>
                <h3>Extra credit</h3>
                <p>Added directly as percentage points to your course grade.</p>
              </div>
            </div>
            <div class="category-score bonus-score">
              <strong id="bonus-total">+0.00</strong>
              <span>points</span>
            </div>
          </div>
          <div class="table-head extra-head" aria-hidden="true">
            <span>Item</span>
            <span>Bonus points</span>
            <span></span>
          </div>
          <div id="extra-rows" class="assignment-list"></div>
          <button id="add-extra" class="add-button" type="button">
            <span aria-hidden="true">+</span> Add extra credit
          </button>
        </section>

        <footer>
          <p>Weighted categories follow the ECE 1111 syllabus. Scores can exceed 100% when extra credit is included.</p>
        </footer>
      </section>
    </div>
  </main>

  <dialog id="reset-dialog">
    <form method="dialog">
      <p class="eyebrow">RESET GRADEBOOK</p>
      <h2>Clear every saved score?</h2>
      <p>This removes all assignment and extra-credit entries from this browser. This cannot be undone.</p>
      <div class="dialog-actions">
        <button class="button button-quiet" value="cancel">Cancel</button>
        <button id="confirm-reset" class="button button-danger" value="confirm">Clear grades</button>
      </div>
    </form>
  </dialog>

  <script is:inline>
    (function () {
      "use strict";

      var STORAGE_KEY = "ece1111-gradebook-v1";
      var categoryDefinitions = [
        { id: "exam1", name: "Exam No. 1", short: "Exam 1", weight: 5, prefix: "Exam 1", multiple: false },
        { id: "exam2", name: "Exam No. 2", short: "Exam 2", weight: 5, prefix: "Exam 2", multiple: false },
        { id: "exam3", name: "Exam No. 3", short: "Exam 3", weight: 5, prefix: "Exam 3", multiple: false },
        { id: "final", name: "Final Exam", short: "Final", weight: 10, prefix: "Final Exam", multiple: false },
        { id: "homework", name: "Homework Assignments", short: "Homework", weight: 25, prefix: "Homework", multiple: true },
        { id: "quizzes", name: "Quizzes", short: "Quizzes", weight: 25, prefix: "Quiz", multiple: true },
        { id: "labs", name: "Laboratory (Labs 1–13)", short: "Labs 1–13", weight: 15, prefix: "Lab", multiple: true },
        { id: "labfinal", name: "Laboratory (Final)", short: "Lab Final", weight: 10, prefix: "Lab Final", multiple: false }
      ];

      function makeId() {
        return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
      }

      function blankItem(name) {
        return { id: makeId(), name: name, earned: "", possible: "" };
      }

      function defaultState() {
        var categories = {};
        categoryDefinitions.forEach(function (category) {
          categories[category.id] = [blankItem(category.prefix)];
        });
        return { categories: categories, extra: [] };
      }

      function safeState(raw) {
        var fallback = defaultState();
        if (!raw || typeof raw !== "object") return fallback;
        categoryDefinitions.forEach(function (category) {
          var rows = raw.categories && Array.isArray(raw.categories[category.id])
            ? raw.categories[category.id]
            : fallback.categories[category.id];
          fallback.categories[category.id] = rows.length ? rows.map(function (row, index) {
            return {
              id: typeof row.id === "string" ? row.id : makeId(),
              name: typeof row.name === "string" ? row.name : category.prefix + (category.multiple ? " " + (index + 1) : ""),
              earned: row.earned === 0 || row.earned ? String(row.earned) : "",
              possible: row.possible === 0 || row.possible ? String(row.possible) : ""
            };
          }) : [blankItem(category.prefix)];
        });
        fallback.extra = Array.isArray(raw.extra) ? raw.extra.map(function (row, index) {
          return {
            id: typeof row.id === "string" ? row.id : makeId(),
            name: typeof row.name === "string" ? row.name : "Extra credit " + (index + 1),
            points: row.points === 0 || row.points ? String(row.points) : ""
          };
        }) : [];
        return fallback;
      }

      function loadState() {
        try {
          return safeState(JSON.parse(localStorage.getItem(STORAGE_KEY)));
        } catch (error) {
          return defaultState();
        }
      }

      var state = loadState();
      var categoriesRoot = document.getElementById("categories");
      var extraRoot = document.getElementById("extra-rows");
      var saveTimer;

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function numberOrNull(value) {
        if (value === "" || value === null || typeof value === "undefined") return null;
        var parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
      }

      function rowIsGraded(row) {
        var earned = numberOrNull(row.earned);
        var possible = numberOrNull(row.possible);
        return earned !== null && possible !== null && earned >= 0 && possible > 0;
      }

      function categoryStats(category) {
        var rows = state.categories[category.id] || [];
        var earned = 0;
        var possible = 0;
        var count = 0;
        rows.forEach(function (row) {
          if (rowIsGraded(row)) {
            earned += Number(row.earned);
            possible += Number(row.possible);
            count += 1;
          }
        });
        var percent = possible > 0 ? earned / possible * 100 : null;
        return {
          earned: earned,
          possible: possible,
          count: count,
          percent: percent,
          contribution: percent === null ? 0 : percent / 100 * category.weight
        };
      }

      function extraTotal() {
        return state.extra.reduce(function (sum, row) {
          var value = numberOrNull(row.points);
          return sum + (value !== null && value >= 0 ? value : 0);
        }, 0);
      }

      function formatPercent(value) {
        return value === null || !Number.isFinite(value) ? "—" : value.toFixed(2) + "%";
      }

      function letterFor(value) {
        if (value === null) return "No grades yet";
        if (value >= 93) return "A";
        if (value >= 90) return "A−";
        if (value >= 87) return "B+";
        if (value >= 83) return "B";
        if (value >= 80) return "B−";
        if (value >= 77) return "C+";
        if (value >= 73) return "C";
        if (value >= 70) return "C−";
        if (value >= 67) return "D+";
        if (value >= 63) return "D";
        if (value >= 60) return "D−";
        return "F";
      }

      function rowMarkup(category, row, index) {
        var canRemove = category.multiple && state.categories[category.id].length > 1;
        return '<div class="assignment-row" data-category="' + category.id + '" data-id="' + row.id + '">' +
          '<label class="field name-field"><span>Assignment name</span><input data-field="name" type="text" value="' + escapeHtml(row.name) + '" aria-label="' + escapeHtml(category.name) + ' assignment name"></label>' +
          '<label class="field score-field"><span>Earned</span><input data-field="earned" type="number" inputmode="decimal" min="0" step="any" value="' + escapeHtml(row.earned) + '" placeholder="—" aria-label="' + escapeHtml(row.name || category.name) + ' points earned"></label>' +
          '<span class="slash" aria-hidden="true">/</span>' +
          '<label class="field score-field"><span>Possible</span><input data-field="possible" type="number" inputmode="decimal" min="0.01" step="any" value="' + escapeHtml(row.possible) + '" placeholder="—" aria-label="' + escapeHtml(row.name || category.name) + ' points possible"></label>' +
          '<span class="row-percent" id="row-percent-' + row.id + '">' + (rowIsGraded(row) ? (Number(row.earned) / Number(row.possible) * 100).toFixed(1) + "%" : "—") + '</span>' +
          (canRemove ? '<button class="icon-button remove-row" type="button" aria-label="Remove ' + escapeHtml(row.name || "assignment") + '"><span aria-hidden="true">×</span></button>' : '<span class="icon-spacer"></span>') +
          '</div>';
      }

      function categoryMarkup(category, index) {
        var stats = categoryStats(category);
        var rows = state.categories[category.id].map(function (row, rowIndex) {
          return rowMarkup(category, row, rowIndex);
        }).join("");
        return '<section class="category-card" data-category-card="' + category.id + '">' +
          '<div class="category-header">' +
            '<div class="category-title">' +
              '<span class="category-index">' + String(index + 1).padStart(2, "0") + '</span>' +
              '<div><h3>' + category.name + '</h3><p>' + category.weight + '% of final grade</p></div>' +
            '</div>' +
            '<div class="category-score"><strong id="category-grade-' + category.id + '">' + formatPercent(stats.percent) + '</strong><span id="category-contribution-' + category.id + '">' + stats.contribution.toFixed(2) + ' / ' + category.weight + ' pts</span></div>' +
          '</div>' +
          '<div class="table-head" aria-hidden="true"><span>Assignment</span><span>Score</span><span>Result</span><span></span></div>' +
          '<div class="assignment-list">' + rows + '</div>' +
          (category.multiple ? '<button class="add-button add-row" type="button" data-add-category="' + category.id + '"><span aria-hidden="true">+</span> Add ' + category.prefix.toLowerCase() + '</button>' : '') +
          '</section>';
      }

      function renderCategories() {
        categoriesRoot.innerHTML = categoryDefinitions.map(categoryMarkup).join("");
      }

      function extraRowMarkup(row) {
        return '<div class="assignment-row extra-row" data-extra-id="' + row.id + '">' +
          '<label class="field name-field"><span>Extra credit item</span><input data-extra-field="name" type="text" value="' + escapeHtml(row.name) + '" aria-label="Extra credit item name"></label>' +
          '<label class="field bonus-field"><span>Bonus points</span><input data-extra-field="points" type="number" inputmode="decimal" min="0" step="any" value="' + escapeHtml(row.points) + '" placeholder="0.00" aria-label="' + escapeHtml(row.name || "Extra credit") + ' percentage points"></label>' +
          '<span class="bonus-unit">pts</span>' +
          '<button class="icon-button remove-extra" type="button" aria-label="Remove ' + escapeHtml(row.name || "extra credit") + '"><span aria-hidden="true">×</span></button>' +
          '</div>';
      }

      function renderExtra() {
        if (!state.extra.length) {
          extraRoot.innerHTML = '<div class="empty-row"><p>No extra credit entered.</p></div>';
        } else {
          extraRoot.innerHTML = state.extra.map(extraRowMarkup).join("");
        }
      }

      function updateSummary() {
        var weightedEarned = 0;
        var gradedWeight = 0;
        var breakdown = [];

        categoryDefinitions.forEach(function (category) {
          var stats = categoryStats(category);
          weightedEarned += stats.contribution;
          if (stats.percent !== null) gradedWeight += category.weight;
          breakdown.push({ category: category, stats: stats });

          var gradeNode = document.getElementById("category-grade-" + category.id);
          var contributionNode = document.getElementById("category-contribution-" + category.id);
          if (gradeNode) gradeNode.textContent = formatPercent(stats.percent);
          if (contributionNode) contributionNode.textContent = stats.contribution.toFixed(2) + " / " + category.weight + " pts";
        });

        var bonus = extraTotal();
        var current = gradedWeight > 0 ? (weightedEarned + bonus) / gradedWeight * 100 : null;
        var coursePoints = weightedEarned + bonus;
        var ringValue = current === null ? 0 : Math.max(0, Math.min(current, 100));

        document.getElementById("current-grade").textContent = formatPercent(current);
        document.getElementById("letter-grade").textContent = current === null ? "No grades yet" : letterFor(current) + " standing";
        document.getElementById("course-points").textContent = coursePoints.toFixed(2);
        document.getElementById("graded-weight").textContent = gradedWeight.toFixed(0) + "%";
        document.getElementById("remaining-weight").textContent = (100 - gradedWeight).toFixed(0) + "% remaining";
        document.getElementById("bonus-total").textContent = "+" + bonus.toFixed(2);
        document.getElementById("grade-ring").style.setProperty("--grade", ringValue * 3.6 + "deg");

        document.getElementById("weight-breakdown").innerHTML = breakdown.map(function (item) {
          var fill = item.stats.percent === null ? 0 : Math.max(0, Math.min(item.stats.percent, 100));
          return '<div class="weight-row">' +
            '<div class="weight-label"><span>' + item.category.short + '</span><strong>' + item.category.weight + '%</strong></div>' +
            '<div class="track"><span style="width:' + fill + '%"></span></div>' +
          '</div>';
        }).join("");
      }

      function saveState() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        var status = document.getElementById("save-status");
        status.textContent = "Saved locally";
        status.classList.add("just-saved");
        clearTimeout(saveTimer);
        saveTimer = setTimeout(function () {
          status.classList.remove("just-saved");
        }, 900);
      }

      function syncAndSave() {
        updateSummary();
        saveState();
      }

      categoriesRoot.addEventListener("input", function (event) {
        var input = event.target.closest("input[data-field]");
        if (!input) return;
        var rowNode = input.closest(".assignment-row");
        var categoryId = rowNode.dataset.category;
        var rowId = rowNode.dataset.id;
        var row = state.categories[categoryId].find(function (item) { return item.id === rowId; });
        if (!row) return;
        row[input.dataset.field] = input.value;
        var percentNode = document.getElementById("row-percent-" + rowId);
        if (percentNode) {
          percentNode.textContent = rowIsGraded(row) ? (Number(row.earned) / Number(row.possible) * 100).toFixed(1) + "%" : "—";
        }
        syncAndSave();
      });

      categoriesRoot.addEventListener("click", function (event) {
        var add = event.target.closest("[data-add-category]");
        if (add) {
          var category = categoryDefinitions.find(function (item) { return item.id === add.dataset.addCategory; });
          var nextNumber = state.categories[category.id].length + 1;
          state.categories[category.id].push(blankItem(category.prefix + " " + nextNumber));
          renderCategories();
          updateSummary();
          saveState();
          var card = categoriesRoot.querySelector('[data-category-card="' + category.id + '"]');
          var inputs = card.querySelectorAll('input[data-field="name"]');
          inputs[inputs.length - 1].focus();
          return;
        }

        var remove = event.target.closest(".remove-row");
        if (remove) {
          var rowNode = remove.closest(".assignment-row");
          var categoryId = rowNode.dataset.category;
          var rowId = rowNode.dataset.id;
          state.categories[categoryId] = state.categories[categoryId].filter(function (item) { return item.id !== rowId; });
          renderCategories();
          updateSummary();
          saveState();
        }
      });

      extraRoot.addEventListener("input", function (event) {
        var input = event.target.closest("input[data-extra-field]");
        if (!input) return;
        var rowNode = input.closest("[data-extra-id]");
        var row = state.extra.find(function (item) { return item.id === rowNode.dataset.extraId; });
        if (!row) return;
        row[input.dataset.extraField] = input.value;
        syncAndSave();
      });

      extraRoot.addEventListener("click", function (event) {
        var remove = event.target.closest(".remove-extra");
        if (!remove) return;
        var id = remove.closest("[data-extra-id]").dataset.extraId;
        state.extra = state.extra.filter(function (item) { return item.id !== id; });
        renderExtra();
        updateSummary();
        saveState();
      });

      document.getElementById("add-extra").addEventListener("click", function () {
        state.extra.push({ id: makeId(), name: "Extra credit " + (state.extra.length + 1), points: "" });
        renderExtra();
        updateSummary();
        saveState();
        var rows = extraRoot.querySelectorAll('input[data-extra-field="name"]');
        rows[rows.length - 1].focus();
      });

      var resetDialog = document.getElementById("reset-dialog");
      document.getElementById("reset-button").addEventListener("click", function () {
        if (typeof resetDialog.showModal === "function") resetDialog.showModal();
      });
      document.getElementById("confirm-reset").addEventListener("click", function () {
        state = defaultState();
        localStorage.removeItem(STORAGE_KEY);
        renderCategories();
        renderExtra();
        updateSummary();
        saveState();
      });

      renderCategories();
      renderExtra();
      updateSummary();
    })();
  </script>

  <style>
    :root {
      --ink: #15141a;
      --muted: #6b6873;
      --paper: #f6f3ed;
      --surface: #ffffff;
      --line: #ded9cf;
      --cherry: #7a1f3d;
      --cherry-dark: #59132b;
      --gold: #dfa93a;
      --mint: #68c3ad;
      --shadow: 0 18px 50px rgba(34, 22, 28, 0.09);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink);
      background: var(--paper);
      font-synthesis: none;
    }

    * { box-sizing: border-box; }
    html { min-width: 320px; background: var(--paper); }
    body { margin: 0; min-height: 100vh; background:
      radial-gradient(circle at 8% 0%, rgba(122, 31, 61, 0.09), transparent 28rem),
      var(--paper);
    }
    button, input { font: inherit; }
    button { color: inherit; }
    .shell { width: min(1480px, 100%); margin: 0 auto; padding: 30px 32px 56px; }
    .topbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
    .eyebrow { margin: 0 0 6px; color: var(--cherry); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.13em; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { margin-bottom: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.25rem, 4vw, 4rem); line-height: 0.95; letter-spacing: -0.035em; }
    h2 { margin-bottom: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.45rem; letter-spacing: -0.02em; }
    h3 { margin-bottom: 4px; font-size: 1rem; line-height: 1.25; }
    .top-actions { display: flex; align-items: center; gap: 14px; }
    .save-status { color: var(--muted); font-size: 0.875rem; transition: color .2s ease; }
    .save-status::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #a8a4ab; }
    .save-status.just-saved { color: #26755f; }
    .save-status.just-saved::before { background: var(--mint); }

    .button { border: 0; border-radius: 9px; padding: 10px 14px; font-size: 0.875rem; font-weight: 750; cursor: pointer; transition: transform .15s ease, background .15s ease; }
    .button:hover { transform: translateY(-1px); }
    .button-quiet { border: 1px solid var(--line); background: rgba(255,255,255,.68); }
    .button-quiet:hover { background: #fff; }
    .button-danger { background: var(--cherry); color: #fff; }
    .button-danger:hover { background: var(--cherry-dark); }

    .dashboard { display: grid; grid-template-columns: minmax(280px, 370px) minmax(0, 1fr); gap: 24px; align-items: start; }
    .summary-panel { position: sticky; top: 24px; display: grid; gap: 15px; }
    .grade-hero, .metric-card, .breakdown-card, .privacy-note, .category-card, .extra-card { background: var(--surface); border: 1px solid rgba(109, 99, 91, .2); box-shadow: var(--shadow); }
    .grade-hero { display: grid; grid-template-columns: 132px 1fr; align-items: center; gap: 22px; padding: 24px; border-top: 5px solid var(--cherry); }
    .ring { --grade: 0deg; width: 132px; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(var(--cherry) var(--grade), #ebe7df 0); position: relative; }
    .ring::after { content: ""; position: absolute; inset: 9px; border-radius: inherit; background: #fff; }
    .ring-inner { position: relative; z-index: 1; text-align: center; }
    .ring-inner strong { display: block; font-family: Georgia, "Times New Roman", serif; font-size: 1.65rem; letter-spacing: -.04em; }
    .ring-inner span { color: var(--muted); font-size: .75rem; }
    .metric-label { display: block; margin-bottom: 4px; color: var(--muted); font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .letter-grade { margin-bottom: 7px; font-family: Georgia, "Times New Roman", serif; font-size: 1.65rem; font-weight: 700; }
    .metric-help { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.45; }
    .metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .metric-card { padding: 18px; box-shadow: 0 10px 28px rgba(34,22,28,.06); }
    .metric-card strong { display: block; margin: 2px 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.6rem; }
    .metric-card > span:last-child { color: var(--muted); font-size: .78rem; }
    .breakdown-card { padding: 22px; }
    .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .section-heading.compact { margin-bottom: 20px; }
    .weight-total { display: grid; place-items: center; width: 48px; aspect-ratio: 1; border: 1px solid #dec0ca; border-radius: 50%; color: var(--cherry); font-size: .8rem; font-weight: 800; }
    .weight-breakdown { display: grid; gap: 12px; }
    .weight-label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 5px; font-size: .8rem; }
    .weight-label strong { color: var(--cherry); }
    .track { height: 5px; overflow: hidden; background: #eeeae3; border-radius: 99px; }
    .track span { display: block; height: 100%; background: linear-gradient(90deg, var(--cherry), #b34a68); border-radius: inherit; transition: width .25s ease; }
    .privacy-note { display: grid; grid-template-columns: auto 1fr; gap: 12px; padding: 16px 18px; color: #345d52; background: #edf7f3; border-color: #cce6dd; box-shadow: none; }
    .privacy-note p { margin: 0; font-size: .8rem; line-height: 1.45; }
    .privacy-note strong { display: block; color: #23463d; }

    .workspace { min-width: 0; }
    .workspace-intro { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 15px; padding: 0 4px; }
    .workspace-intro > p { max-width: 340px; margin: 0; color: var(--muted); font-size: .875rem; text-align: right; line-height: 1.5; }
    .categories { display: grid; gap: 14px; }
    .category-card, .extra-card { overflow: hidden; box-shadow: 0 10px 32px rgba(34,22,28,.055); }
    .category-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 20px; border-bottom: 1px solid var(--line); }
    .category-title { display: flex; align-items: center; gap: 14px; min-width: 0; }
    .category-title h3 { font-size: 1.02rem; }
    .category-title p { margin: 0; color: var(--muted); font-size: .78rem; }
    .category-index { display: grid; place-items: center; flex: 0 0 38px; width: 38px; aspect-ratio: 1; border-radius: 50%; background: #f2e6ea; color: var(--cherry); font-size: .72rem; font-weight: 850; }
    .bonus-index { background: #f9efd6; color: #8b6417; font-size: 1.2rem; }
    .category-score { flex: 0 0 auto; text-align: right; }
    .category-score strong { display: block; font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; }
    .category-score span { color: var(--muted); font-size: .72rem; }
    .bonus-score strong { color: #8b6417; }
    .table-head { display: grid; grid-template-columns: minmax(140px, 1fr) 270px 70px 34px; gap: 12px; padding: 9px 20px; color: var(--muted); background: #faf9f6; border-bottom: 1px solid var(--line); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .table-head span:nth-child(2) { text-align: center; }
    .table-head span:nth-child(3) { text-align: right; }
    .assignment-list { padding: 0 20px; }
    .assignment-row { display: grid; grid-template-columns: minmax(140px, 1fr) 118px 10px 118px 70px 34px; align-items: end; gap: 8px; padding: 13px 0; border-bottom: 1px solid #ece8e1; }
    .assignment-row:last-child { border-bottom: 0; }
    .field { display: grid; gap: 5px; min-width: 0; }
    .field > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    input { width: 100%; min-height: 40px; border: 1px solid #d6d1c7; border-radius: 8px; padding: 9px 11px; color: var(--ink); background: #fff; outline: none; transition: border-color .15s ease, box-shadow .15s ease; }
    input:hover { border-color: #aaa39a; }
    input:focus { border-color: var(--cherry); box-shadow: 0 0 0 3px rgba(122,31,61,.12); }
    input::placeholder { color: #aaa6ad; }
    .score-field input { text-align: right; font-variant-numeric: tabular-nums; }
    .slash { align-self: center; padding-bottom: 10px; color: #aaa6ad; text-align: center; }
    .row-percent { align-self: center; color: var(--muted); padding-bottom: 10px; text-align: right; font-size: .83rem; font-weight: 750; font-variant-numeric: tabular-nums; }
    .icon-button { align-self: center; width: 34px; height: 34px; border: 0; border-radius: 8px; color: #8a838b; background: transparent; cursor: pointer; }
    .icon-button:hover { color: var(--cherry); background: #f6e9ed; }
    .icon-button span { font-size: 1.35rem; line-height: 1; }
    .icon-spacer { width: 34px; }
    .add-button { display: inline-flex; align-items: center; gap: 8px; margin: 2px 20px 16px; border: 0; padding: 8px 0; color: var(--cherry); background: transparent; font-size: .82rem; font-weight: 800; cursor: pointer; }
    .add-button:hover { color: var(--cherry-dark); }
    .add-button span { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid currentColor; border-radius: 50%; }
    .extra-card { margin-top: 14px; border-top: 4px solid var(--gold); }
    .extra-head { grid-template-columns: minmax(140px, 1fr) 170px 34px; }
    .extra-row { grid-template-columns: minmax(140px, 1fr) 145px 42px 34px; }
    .bonus-field input { text-align: right; }
    .bonus-unit { align-self: center; padding-bottom: 10px; color: var(--muted); font-size: .78rem; }
    .empty-row { padding: 18px 0; color: var(--muted); font-size: .84rem; }
    .empty-row p { margin: 0; }
    footer { padding: 20px 4px 0; }
    footer p { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.5; }

    dialog { width: min(440px, calc(100% - 32px)); border: 1px solid var(--line); border-radius: 4px; padding: 0; color: var(--ink); background: #fff; box-shadow: 0 30px 90px rgba(20,10,15,.3); }
    dialog::backdrop { background: rgba(20,15,18,.55); backdrop-filter: blur(3px); }
    dialog form { padding: 26px; }
    dialog h2 { margin-bottom: 10px; }
    dialog form > p:not(.eyebrow) { color: var(--muted); line-height: 1.55; }
    .dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }

    @media (max-width: 1020px) {
      .dashboard { grid-template-columns: 1fr; }
      .summary-panel { position: static; grid-template-columns: 1.3fr 1fr; }
      .grade-hero { grid-row: span 2; }
      .metric-grid { align-self: stretch; }
      .breakdown-card { grid-column: 1 / -1; }
      .weight-breakdown { grid-template-columns: repeat(2, 1fr); gap: 13px 28px; }
      .privacy-note { grid-column: 1 / -1; }
    }

    @media (max-width: 720px) {
      .shell { padding: 22px 16px 40px; }
      .topbar { align-items: flex-start; }
      .top-actions { flex-direction: column-reverse; align-items: flex-end; gap: 8px; }
      .summary-panel { grid-template-columns: 1fr; }
      .grade-hero { grid-row: auto; }
      .breakdown-card, .privacy-note { grid-column: auto; }
      .workspace-intro { align-items: flex-start; flex-direction: column; gap: 8px; }
      .workspace-intro > p { text-align: left; }
      .table-head { display: none; }
      .assignment-list { padding: 0 14px; }
      .assignment-row { grid-template-columns: minmax(0, 1fr) 70px 8px 70px 54px 30px; gap: 5px; }
      .field > span { position: static; width: auto; height: auto; overflow: visible; clip: auto; color: var(--muted); font-size: .67rem; }
      .name-field { grid-column: 1 / -1; }
      .assignment-row input { padding: 8px; }
      .row-percent { font-size: .75rem; }
      .category-header { align-items: flex-start; padding: 16px 14px; }
      .category-title { gap: 10px; }
      .category-index { flex-basis: 34px; width: 34px; }
      .category-score strong { font-size: 1.15rem; }
      .category-score span { display: block; max-width: 80px; }
      .add-button { margin-left: 14px; }
      .extra-row { grid-template-columns: minmax(0, 1fr) 90px 34px 30px; }
      .extra-row .name-field { grid-column: 1 / -1; }
      .bonus-unit { padding-bottom: 11px; }
    }

    @media (max-width: 430px) {
      .save-status { display: none; }
      .grade-hero { grid-template-columns: 108px 1fr; padding: 18px; }
      .ring { width: 108px; }
      .ring-inner strong { font-size: 1.35rem; }
      .metric-grid { gap: 10px; }
      .metric-card { padding: 14px; }
      .weight-breakdown { grid-template-columns: 1fr; }
      .assignment-row { grid-template-columns: minmax(0, 1fr) 62px 7px 62px 48px 28px; }
      .row-percent { font-size: .69rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>
</body>
</html>
